{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "plan",
  "rules": {
    "document": {
      "type": "SYMBOL",
      "name": "map"
    },
    "map": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "pair"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "vector": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_value"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "pair": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "field"
        },
        {
          "type": "SYMBOL",
          "name": "_value"
        }
      ]
    },
    "field": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "map"
        },
        {
          "type": "SYMBOL",
          "name": "vector"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "multiline"
        },
        {
          "type": "SYMBOL",
          "name": "reserved"
        },
        {
          "type": "SYMBOL",
          "name": "id_reference"
        },
        {
          "type": "SYMBOL",
          "name": "plain_scalar"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-z][a-z0-9]*(?:-[a-z0-9]+)*"
    },
    "id_reference": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "@(?:[^\\s,{}\\[\\]\"`\\\\:();/@]+|\\/[^/*\\s,{}\\[\\]\"`\\\\:();@][^\\s,{}\\[\\]\"`\\\\:();/@]*)*\\/?"
      }
    },
    "plain_scalar": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "(?:[^\\s,{}\\[\\]\"`\\\\:();/@#\\x27~^]+|\\/[^/*\\s,{}\\[\\]\"`\\\\:();@#\\x27~^][^\\s,{}\\[\\]\"`\\\\:();/@#\\x27~^]*)(?:\\/[^/*\\s,{}\\[\\]\"`\\\\:();@#\\x27~^][^\\s,{}\\[\\]\"`\\\\:();/@#\\x27~^]*)*\\/?|\\/"
      }
    },
    "string": {
      "type": "PATTERN",
      "value": "\"(?:\\\\.|[^\"\\\\\\r\\n])*\""
    },
    "multiline": {
      "type": "PATTERN",
      "value": "`[^`\\\\]*(?:\\\\.[^`\\\\]*)*`"
    },
    "reserved": {
      "type": "SYMBOL",
      "name": "paren"
    },
    "paren": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "PATTERN",
            "value": "[^()]*"
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": "[^\\r\\n]*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r\\n]+"
    },
    {
      "type": "STRING",
      "value": ","
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
